# ─────────────────────────────────────────────────────────────
# Zalo KO-VI Translator — Backend 환경 변수 (예시)
# 실제 사용 시 이 파일을 `.env` 로 복사한 뒤 값을 채워 넣으세요.
# .env 는 절대 커밋하지 마세요 (.gitignore 에 등록됨).
# ─────────────────────────────────────────────────────────────

# Google Cloud Translation API 키 (NF-03: 서버에서만 관리, 클라이언트 노출 금지)
GOOGLE_TRANSLATE_API_KEY=your-google-cloud-api-key-here

# 사용할 Google Translation API 버전: "v2" (API 키 기반, 기본값) 또는 "v3"
GOOGLE_TRANSLATE_API_VERSION=v2

# v3 사용 시 필요한 GCP 프로젝트 ID (v2 사용 시 무시됨)
GOOGLE_PROJECT_ID=

# 백엔드 서버 포트
PORT=8787

# 번역 결과 캐시 최대 항목 수 (비용 절감용, 리스크 대응)
TRANSLATION_CACHE_SIZE=2000

# SQLite DB 파일 경로 (NF-04: 로컬 저장소에만 보관)
DB_PATH=./data/history.db
